# ==============================================================================
# AWS Field Presales Command Centre — Environment Configuration Template
# Copy to .env and configure values before starting the application.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# Public Portal URL (used in credential TXT files and redirect validations)
PORTAL_URL=https://13.235.2.205

# Persistent Database File Path
# Local development default: ./data/command_centre.db
# EC2 Production default: /var/data/command-centre/db/command_centre.db
DB_PATH=./data/command_centre.db

# Cookie & Session Security Settings
# Generate a cryptographically secure random secret for cookie signing (e.g. openssl rand -hex 32)
SESSION_SECRET=replace_with_a_64_character_random_hex_string_in_production
SESSION_MAX_AGE_HOURS=24
COOKIE_SECURE=true

# Initial Admin Bootstrap (Used only by npm run seed if database has 0 admins)
INITIAL_ADMIN_USERNAME=Rupak
INITIAL_ADMIN_EMAIL=rupak@redington.com
INITIAL_ADMIN_NAME=Rupak
INITIAL_ADMIN_PASSWORD=Admin@Presales2026!
